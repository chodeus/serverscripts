[Unit]
Description=PVE host tweaks: CPU governor powersave + NIC Wake-on-LAN
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "echo powersave | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null"
ExecStart=/usr/sbin/ethtool -s nic0 wol g

[Install]
WantedBy=multi-user.target
